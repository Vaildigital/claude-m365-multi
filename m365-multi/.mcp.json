{
  "mcpServers": {
    "m365": {
      "command": "npx",
      "args": [
        "-y",
        "@softeria/ms-365-mcp-server@0.145.0",
        "--preset",
        "outlook",
        "--allowed-scopes",
        "Mail.ReadWrite Mail.Send Calendars.ReadWrite User.Read"
      ]
    },
    "m365-login": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/login-helper.mjs"]
    }
  }
}
